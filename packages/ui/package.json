{
  "name": "@hamro-design-system/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css.ts"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./button": {
      "types": "./src/components/button/index.ts",
      "default": "./src/components/button/index.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --external react,react-dom",
    "dev": "tsup src/index.ts --format esm --dts --watch --external react,react-dom",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.1.0",
    "@hamro-design-system/tokens": "workspace:*",
    "@hamro-design-system/utils": "workspace:*"
  },
  "devDependencies": {
    "@testing-library/react": "^16.2.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "tsup": "^8.0.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
