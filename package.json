  "scripts": {
    "build:dev": "rimraf dist && NODE_ENV=development rollup -c rollup.config.js --bundleConfigAsCjs",
    "build:prod": "rimraf dist && rollup -c rollup.config.js --bundleConfigAsCjs",
    "lint": "eslint \"./{src,stories}/**/*.{jsx,js}\"",
    "lint:fix": "eslint \"./{src,stories}/**/*.{jsx,js}\" --fix",
    "postinstall": "husky install",
    "prepare:all": "npm run prepare:svg && npm run prepare:token",
    "prepare:font": "fantasticon && sh ./prepare_fonts.sh",
    "prepare:logo": "npx @svgr/cli --ext jsx --out-dir src/components/Atoms/Logo -- assets/svg/logo",
    "prepare:product_logo": "npx @svgr/cli --ext jsx --out-dir src/components/Atoms/ProductLogo/Logos -- assets/svg/products_logo",
    "prepare:svg": "npm run prepare:logo && prepare:product_logo && npm run prepare:font",
    "prepare:token": "style-dictionary build --config sd.config.json",
    "storybook:deploy": "rimraf storybook-static && npm run storybook:build && sh ./deploy_storybook.sh prod",
    "storybook:build": "storybook build",
    "storybook:run": "storybook dev -p 6006",
    "test": "jest",
    "test:silent": "jest --silent"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/d-lighted/receptionist-design-system.git"
  },
