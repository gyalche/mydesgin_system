{
  "name": "receptionist-designsystem",
  "keywords": [],
  "author": "",
  "license": "MIT",
  "version": "1.0.0",
  "description": "",
  "main": "dist/receptionist-designsystem.cjs.js",
  "module": "dist/receptionist-designsystem.esm.js",
  "browser": {
    "./dist/receptionist-designsystem.esm.js": "./dist/receptionist-designsystem.browser.esm.js"
  },
  "exports": {
    ".": {
      "module": {
        "worker": "./dist/receptionist-designsystem.worker.esm.js",
        "browser": "./dist/receptionist-designsystem.browser.esm.js",
        "default": "./dist/receptionist-designsystem.esm.js"
      },
      "default": "./dist/receptionist-designsystem.cjs.js"
    },
    "./package.json": "./package.json"
  },
  "preconstruct": {
    "exports": {
      "envConditions": [
        "browser",
        "worker"
      ]
    },
    "entrypoints": [
      "index.js"
    ]
  },
  "devDependencies": {
    "@babel/cli": "7.22.9",
    "@babel/core": "7.22.9",
    "@babel/plugin-syntax-jsx": "7.22.5",
    "@babel/polyfill": "7.12.1",
    "@babel/preset-env": "7.22.9",
    "@babel/preset-react": "7.22.5",
    "@preconstruct/cli": "2.8.1",
    "@storybook/addon-essentials": "7.1.1",
    "@storybook/addon-interactions": "7.1.1",
    "@storybook/addon-links": "7.1.1",
    "@storybook/blocks": "7.1.1",
    "@storybook/react": "7.1.1",
    "@storybook/react-vite": "7.1.1",
    "@storybook/testing-library": "0.2.0",
    "@svgr/cli": "8.0.1",
    "babel-plugin-styled-components": "2.1.4",
    "eslint": "8.45.0",
    "eslint-config-standard": "17.1.0",
    "eslint-plugin-import": "2.27.5",
    "eslint-plugin-n": "16.0.1",
    "eslint-plugin-promise": "6.1.1",
    "eslint-plugin-react": "7.32.2",
    "eslint-plugin-storybook": "0.6.13",
    "fantasticon": "^2.0.0",
    "husky": "7.0.4",
    "prop-types": "15.8.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "storybook": "7.1.1",
    "storybook-addon-designs": "^6.3.1",
    "styled-components": "6.0.3",
    "vite": "4.4.4"
  },
  "peerDependencies": {
    "react": "^16.13.1 || ^17.0.0 || ^18.0.0",
    "react-dom": "^16.13.1 || ^17.0.0 || ^18.0.0",
    "styled-components": "^6.0.3"
  },
  "scripts": {
    "build": "preconstruct build",
    "build-storybook": "storybook build",
    "font": "fantasticon && sh ./prepare_fonts.sh",
    "lint": "eslint --ext .js,.jsx src",
    "lint:fix": "eslint --ext .js,.jsx src --fix",
    "logo": "npx @svgr/cli --ext jsx --out-dir src/components/Atoms/Logo -- assets/svg/logo",
    "postinstall": "husky install",
    "storybook": "storybook dev -p 6006",
    "svg:prepare": "npm run logo && npm run font",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/d-lighted/receptionist-design-system.git"
  },
  "bugs": {
    "url": "https://github.com/d-lighted/receptionist-design-system/issues"
  },
  "homepage": "https://github.com/d-lighted/receptionist-design-system#readme"
}
