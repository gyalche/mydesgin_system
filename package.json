{
  "name": "hamro-design-system",
  "keywords": [],
  "author": "",
  "license": "MIT",
  "version": "0.4.2",
  "description": "Hamro Design System for React applications",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "require": "./dist/index.cjs",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@babel/cli": "7.22.9",
    "@babel/core": "7.22.9",
    "@babel/eslint-parser": "7.25.9",
    "@babel/plugin-syntax-jsx": "7.22.5",
    "@babel/polyfill": "7.12.1",
    "@babel/preset-env": "7.22.9",
    "@babel/preset-react": "7.22.5",
    "@rollup/plugin-babel": "6.0.3",
    "@rollup/plugin-commonjs": "28.0.3",
    "@rollup/plugin-node-resolve": "16.0.1",
    "@rollup/plugin-terser": "0.4.3",
    "@storybook/addon-designs": "8.2.1",
    "@storybook/addon-docs": "8.6.4",
    "@storybook/addon-essentials": "8.6.4",
    "@storybook/addon-interactions": "8.6.4",
    "@storybook/addon-links": "8.6.4",
    "@storybook/blocks": "8.6.4",
    "@storybook/manager-api": "8.6.4",
    "@storybook/react": "8.6.4",
    "@storybook/react-vite": "8.6.4",
    "@storybook/test": "8.6.4",
    "@storybook/theming": "8.6.4",
    "@stylistic/eslint-plugin-js": "2.12.1",
    "@svgr/cli": "8.0.1",
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "6.1.2",
    "@testing-library/react": "16.2.0",
    "@vitejs/plugin-react": "4.3.4",
    "babel-plugin-styled-components": "2.1.4",
    "cssnano": "7.0.6",
    "eslint": "8.45.0",
    "eslint-config-airbnb": "19.0.4",
    "eslint-config-standard": "17.1.0",
    "eslint-plugin-import": "2.27.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-n": "16.0.1",
    "eslint-plugin-promise": "6.6.0",
    "eslint-plugin-react": "7.32.2",
    "eslint-plugin-react-hooks": "4.6.2",
    "expect": "29.6.4",
    "fantasticon": "3.0.0",
    "final-form": "4.20.10",
    "husky": "7.0.4",
    "identity-obj-proxy": "3.0.0",
    "jest": "29.6.4",
    "jest-environment-jsdom": "29.6.4",
    "jest-styled-components": "7.1.1",
    "jsdom": "26.0.0",
    "path": "0.12.7",
    "postcss-discard-comments": "6.0.0",
    "prop-types": "15.8.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-final-form": "6.5.9",
    "remark-gfm": "4.0.1",
    "rimraf": "6.0.1",
    "rollup": "3.27.0",
    "rollup-plugin-includepaths": "0.2.4",
    "rollup-plugin-peer-deps-external": "2.2.4",
    "rollup-plugin-postcss": "4.0.2",
    "storybook": "8.6.4",
    "storybook-addon-designs": "6.3.1",
    "style-dictionary": "4.3.3",
    "styled-components": "6.0.3",
    "vite": "4.4.4"
  },
  "peerDependencies": {
    "prop-types": "^15.0.0",
    "react": "^16.13.1 || ^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^16.13.1 || ^17.0.0 || ^18.0.0 || ^19.0.0",
    "styled-components": "^6.0.3"
  },
  "scripts": {
    "build:dev": "rimraf dist && NODE_ENV=development rollup -c rollup.config.js --bundleConfigAsCjs",
    "build:prod": "rimraf dist && rollup -c rollup.config.js --bundleConfigAsCjs",
    "lint": "eslint \"./{src,stories}/**/*.{jsx,js}\"",
    "lint:fix": "eslint \"./{src,stories}/**/*.{jsx,js}\" --fix",
    "prepare": "husky install",
    "prepare:all": "npm run prepare:svg && npm run prepare:token",
    "prepare:font": "fantasticon && sh ./prepare_fonts.sh",
    "prepare:logo": "npx @svgr/cli --ext jsx --out-dir src/components/Atoms/Logo -- assets/svg/logo",
    "prepare:product_logo": "npx @svgr/cli --ext jsx --out-dir src/components/Atoms/ProductLogo/Logos -- assets/svg/products_logo",
    "prepare:svg": "npm run prepare:logo && prepare:product_logo && npm run prepare:font",
    "prepare:token": "style-dictionary build --config sd.config.json",
    "storybook:deploy": "npx rimraf storybook-static && sh ./deploy_storybook.sh prod",
    "storybook:build": "storybook build",
    "storybook:run": "storybook dev -p 6006",
    "pack:check": "npm run build:prod && npm pack --dry-run",
    "prepublishOnly": "npm run build:prod && npm run test:silent",
    "test": "jest",
    "test:silent": "jest --silent"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/d-lighted/sherpa-design-system.git"
  },
  "bugs": {
    "url": "https://github.com/d-lighted/sherpa-design-system/issues"
  },
  "homepage": "https://github.com/d-lighted/sherpa-design-system#readme",
  "dependencies": {
    "downshift": "8.1.0"
  }
}
